NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_CDN_URL=https://cdn.yssports.com
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=mt1
NEXT_PUBLIC_APP_NAME=YS Sports
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_VAPID_PUBLIC_KEY=              # web-push VAPID public key for push notifications
NEXT_PUBLIC_SUPPORT_EMAIL=support@yssports.com
SENTRY_TRACES_SAMPLE_RATE=0.1             # 0.0–1.0; 0 disables server-side tracing
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1 # 0.0–1.0; 0 disables client-side tracing
NEXT_PUBLIC_SENTRY_DSN=          # https://your-dsn@sentry.io/123
SENTRY_DSN=                      # https://your-dsn@sentry.io/123 (server-side)
SENTRY_ORG=                      # your-sentry-org
SENTRY_PROJECT=                  # your-sentry-project
SENTRY_AUTH_TOKEN=               # create auth token in Sentry org settings
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=    # site domain on Plausible, e.g. yssports.com (empty = analytics disabled)
NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io   # self-hosted: https://plausible.your-domain.com
